from confusables import is_confusable
import tkinter as tk
from tkinter import messagebox, filedialog
import pyperclip
import threading
import time


# ------------------- Detection Logic ------------------- #

def is_homograph(domain: str) -> bool:
    try:
        ascii_version = idna.encode(domain).decode('ascii')
        if domain == ascii_version:
            return False
    except Exception:
        return True

    for ch in domain:
        if is_confusable(ch, preferred_aliases=["LATIN"]):
            return True
    return False


def log_scan(domain, result):
    with open("scan_results.log", "a", encoding="utf-8") as log:
        log.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} - {domain} : {result}\n")


# ------------------- GUI-Related Functions ------------------- #

def check_domain(event=None):
    domain = domain_entry.get().strip()
    if not domain:
        result_label.config(text="⚠️ Please enter a domain name", fg="orange")
        return

    if is_homograph(domain):
        result_label.config(text=f"⚠️ Suspicious domain detected:\n{domain}", fg="red")
        log_scan(domain, "Suspicious")
    else:
        result_label.config(text=f"✅ Domain looks safe:\n{domain}", fg="green")
        log_scan(domain, "Safe")


def clear_input():
    domain_entry.delete(0, tk.END)
    result_label.config(text="")


def exit_app():
    root.destroy()


def show_clipboard_warning(domain):
    messagebox.showwarning("Suspicious Domain!", f"⚠️ Clipboard contains a suspicious domain:\n{domain}")
    log_scan(domain, "Suspicious (Clipboard)")


# ------------------- Clipboard Monitoring Thread ------------------- #

def clipboard_watcher():
    last_text = ""
    while True:
        try:
            text = pyperclip.paste().strip()
            if text != last_text and "." in text:
                last_text = text
                if is_homograph(text):
                    root.after(0, lambda: show_clipboard_warning(text))
        except Exception as e:
            print("Clipboard check failed:", e)
        time.sleep(2)


# ------------------- File Scanner ------------------- #

def scan_from_file():
    filepath = filedialog.askopenfilename(filetypes=[("Text files", "*.txt")])
    if not filepath:
        return

    try:
        with open(filepath, "r", encoding="utf-8") as f:
            domains = [line.strip() for line in f if line.strip()]
    except Exception as e:
        messagebox.showerror("File Error", f"Failed to read file: {e}")
        return

    suspicious = []
    for domain in domains:
        result = is_homograph(domain)
        if result:
            suspicious.append(domain)
        log_scan(domain, "Suspicious" if result else "Safe")

    if suspicious:
        messagebox.showwarning("Scan Complete", f"⚠️ {len(suspicious)} suspicious domains found.")
    else:
        messagebox.showinfo("Scan Complete", "✅ No suspicious domains found.")


# ------------------- GUI Setup ------------------- #

root = tk.Tk()
root.title("🔍 Homograph Attack Detector")
root.geometry("500x270")
root.resizable(False, False)
root.configure(bg="#f7f7f7")

FONT = ("Segoe UI", 12)
TITLE_FONT = ("Segoe UI", 16, "bold")

title_label = tk.Label(root, text="Homograph Attack Detector", font=TITLE_FONT, bg="#f7f7f7")
title_label.pack(pady=10)

entry_frame = tk.Frame(root, bg="#f7f7f7")
entry_frame.pack(pady=5)

domain_entry = tk.Entry(entry_frame, font=FONT, width=40)
domain_entry.pack(side="left", padx=5)
domain_entry.bind("<Return>", check_domain)
domain_entry.focus()

check_btn = tk.Button(entry_frame, text="Check", command=check_domain, font=FONT, bg="#d9f9d9", width=10)
check_btn.pack(side="left", padx=5)

result_label = tk.Label(root, text="", font=FONT, bg="#f7f7f7", justify="center")
result_label.pack(pady=15)

action_frame = tk.Frame(root, bg="#f7f7f7")
action_frame.pack(pady=5)

clear_btn = tk.Button(action_frame, text="Clear", command=clear_input, font=FONT, bg="#eee", width=10)
clear_btn.pack(side="left", padx=10)

scan_btn = tk.Button(action_frame, text="Scan From File", command=scan_from_file, font=FONT, bg="#def", width=15)
scan_btn.pack(side="left", padx=10)

exit_btn = tk.Button(action_frame, text="Exit", command=exit_app, font=FONT, bg="#fcc", width=10)
exit_btn.pack(side="left", padx=10)

# Start clipboard monitor thread
threading.Thread(target=clipboard_watcher, daemon=True).start()

# Start GUI
root.mainloop() : Suspicious (Clipboard)
