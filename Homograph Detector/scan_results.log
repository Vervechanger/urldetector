from confusables import is_confusable
import tkinter as tk
from tkinter import messagebox, filedialog
import pyperclip
import threading
import time
import re
import tldextract

# ------------------- Global State ------------------- #
user_popup_permission = None  # Ask once
DOMAIN_REGEX = re.compile(r"^(?!.*\s)[\w\-.]+\.[a-z]{2,}$", re.IGNORECASE)

# ------------------- Domain Detection ------------------- #

def is_homograph(domain: str) -> bool:
    try:
        ascii_version = idna.encode(domain).decode('ascii')
        if domain == ascii_version:
            return False
    except Exception:
        return True

    for ch in domain:
        if is_confusable(ch):
            return True
    return False

def is_valid_domain_format(domain: str) -> bool:
    # Use tldextract to make sure it's a valid domain
    ext = tldextract.extract(domain)
    return bool(ext.domain and ext.suffix)  # Ensure something.domain

def log_scan(domain, result):
    with open("scan_results.log", "a", encoding="utf-8") as log:
        log.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} - {domain} : {result}\n")

# ------------------- GUI Functions ------------------- #

def check_domain(event=None):
    domain = domain_entry.get().strip()
    if not is_valid_domain_format(domain):
        result_label.config(text="⚠️ Not a valid domain format.", fg="orange")
        return

    if is_homograph(domain):
        result_label.config(text=f"⚠️ Suspicious domain detected:\n{domain}", fg="red")
        log_scan(domain, "Suspicious")
    else:
        result_label.config(text=f"✅ Domain looks safe:\n{domain}", fg="green")
        log_scan(domain, "Safe")

def clear_input():
    domain_entry.delete(0, tk.END)
    result_label.config(text="")

def exit_app():
    root.destroy()

def show_clipboard_warning(domain):
    global user_popup_permission
    log_scan(domain, "Suspicious (Clipboard)")

    if user_popup_permission is None:
        response = messagebox.askyesno(
            "Allow Popups?",
            f"⚠️ Suspicious domain copied:\n\n{domain}\n\n"
            "Do you want to see warning popups like this in the future?"
        )
        user_popup_permission = response

    if user_popup_permission:
        messagebox.showwarning("Suspicious Domain!", f"⚠️ Clipboard contains a suspicious domain:\n{domain}")
    else:
        result_label.config(text=f"⚠️ Suspicious domain copied:\n{domain}", fg="red")

# ------------------- Clipboard Monitor ------------------- #

def clipboard_watcher():
    last_text = ""
    while True:
        try:
            text = pyperclip.paste().strip()
            if text != last_text:
                last_text = text
                if DOMAIN_REGEX.match(text) and is_valid_domain_format(text):
                    if is_homograph(text):
                        root.after(0, lambda t=text: show_clipboard_warning(t))
        except Exception as e:
            print("Clipboard check failed:", e)
        time.sleep(2)

# ------------------- File Scanner ------------------- #

def scan_from_file():
    filepath = filedialog.askopenfilename(filetypes=[("Text files", "*.txt")])
    if not filepath:
        return

    try:
        with open(filepath, "r", encoding="utf-8") as f:
            domains = [line.strip() for line in f if line.strip()]
    except Exception as e:
        messagebox.showerror("File Error", f"Failed to read file: {e}")
        return

    suspicious = []
